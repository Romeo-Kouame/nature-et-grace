generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  payment_review
  confirmed
  preparing
  shipped
  delivered
  cancelled
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StoreSettings {
  id                String   @id @default("store")
  whatsappNumber    String   @default("2250717684751")
  deliveryCommunes  String   @default("Abidjan, Bouaké, Daloa et autres communes sur demande")
  deliveryInfo      String   @default("Frais et délais communiqués avant la validation définitive.")
  waveInstructions  String   @default("Les modalités de paiement Wave sont confirmées par la boutique.")
  updatedAt         DateTime @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  category    String
  description String
  size        String
  priceXof    Int?
  imageUrl    String?
  stock       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Order {
  id             String      @id @default(cuid())
  customerName   String
  phone          String
  commune        String
  address        String
  deliveryNote   String?
  status         OrderStatus @default(pending)
  totalXof       Int
  paymentProofUrl String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  productSize    String
  unitPriceXof   Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}
