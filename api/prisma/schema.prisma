generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  payment_review
  confirmed
  preparing
  shipped
  delivered
  cancelled
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StoreSettings {
  id                String   @id @default("store")
  whatsappNumber    String   @default("2250717684751")
  deliveryCommunes  String   @default("Abidjan, Bouaké, Daloa et autres communes sur demande")
  deliveryInfo      String   @default("Frais et délais communiqués avant la validation définitive.")
  waveInstructions  String   @default("Les modalités de paiement Wave sont confirmées par la boutique.")
  /// Numéro ou lien de paiement Wave de la boutique (vide tant qu'il n'est pas communiqué)
  waveNumber        String   @default("")
  /// Zones de livraison : [{ "name": "Cocody", "feeXof": 1000, "delay": "24 h" }] — feeXof null = à confirmer
  deliveryZones     Json     @default("[]")
  /// Identité légale affichée dans les mentions légales (raison sociale, RCCM, adresse…)
  legalInfo         String   @default("")
  updatedAt         DateTime @updatedAt
}

/// Photos produits et preuves de paiement, stockées en base pour ne dépendre d'aucun hébergeur de fichiers.
model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  /// true = preuve de paiement, visible uniquement depuis l'administration
  private   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  authorName  String
  city        String
  productSlug String?
  productName String?
  rating      Int
  comment     String
  /// Un avis déposé sur le site attend la validation de la boutique
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  category    String
  description String
  size        String
  priceXof    Int?
  imageUrl    String?
  /// Photos supplémentaires (galerie de la fiche produit, 2e photo au survol)
  gallery     String[]    @default([])
  /// Pastille affichée sur la carte : "bestseller" (Meilleure vente) ou "new" (Nouveau)
  badge       String?
  stock       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

/// Compte client : obligatoire pour accéder au panier et commander
model Customer {
  id            String   @id @default(cuid())
  name          String
  /// Numéro ivoirien normalisé : 225 + 10 chiffres
  phone         String   @unique
  email         String?  @unique
  passwordHash  String
  commune       String?
  address       String?
  deliveryZone  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Order {
  id             String      @id @default(cuid())
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  phone          String
  commune        String
  address        String
  deliveryNote   String?
  status         OrderStatus @default(pending)
  /// Total des produits (hors livraison)
  totalXof       Int
  deliveryZone   String?
  /// Frais de livraison connus au moment de la commande ; null = à confirmer par la boutique
  deliveryFeeXof Int?
  paymentProofUrl String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  productSize    String
  unitPriceXof   Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}
