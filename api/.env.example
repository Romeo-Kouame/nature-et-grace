DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
WEB_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"
# "true" une fois l'API derrière un hébergeur (proxy) : les limites anti-abus utilisent alors la vraie IP
TRUST_PROXY="false"
ADMIN_EMAIL="owner@example.com"
ADMIN_INITIAL_PASSWORD="replace-before-first-run"
# Clé Google Gemini API pour le Conseiller Beauté IA et la génération de descriptions
GEMINI_API_KEY="your-gemini-api-key-here"
