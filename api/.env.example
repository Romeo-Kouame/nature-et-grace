DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
WEB_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"
# Laisser vide si le site et l'API sont sur des domaines différents.
# "lax" si l'API est sur un sous-domaine du site (ex. api.mondomaine.ci) : protection CSRF renforcée
COOKIE_SAMESITE=""
# "true" une fois l'API derrière un hébergeur (proxy) : les limites anti-abus utilisent alors la vraie IP
TRUST_PROXY="false"
ADMIN_EMAIL="owner@example.com"
ADMIN_INITIAL_PASSWORD="replace-before-first-run"
# Clé Google Gemini API pour le Conseiller Beauté IA et la génération de descriptions
GEMINI_API_KEY="your-gemini-api-key-here"
# Plafond d'appels Gemini par jour (maîtrise des coûts) ; au-delà, conseils de démonstration jusqu'au lendemain
GEMINI_DAILY_LIMIT="300"
# "production" en ligne : active HTTPS obligatoire et l'en-tête HSTS
NODE_ENV="development"
# Connexion avec Google (facultatif ; vide = bouton Google masqué sur le site)
# Console Google Cloud → API et services → Identifiants → « ID client OAuth » de type « Application Web ».
# URI de redirection autorisée à déclarer chez Google : exactement la valeur de GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/customer/google/callback"
# Captcha Cloudflare Turnstile (inscription, connexion, finalisation Google, avis). Vide = désactivé.
# Clé de test (développement, toujours valide) : 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=""
# Domaines du site autorisés par le captcha, séparés par des virgules. En production : sans localhost.
TURNSTILE_HOSTNAMES="localhost"
