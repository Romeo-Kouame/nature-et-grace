VITE_API_URL=http://localhost:3001/api
# Adresse publique du site (sitemap, robots.txt, données Google, image de partage)
VITE_SITE_URL=https://www.exemple.ci
# Facultatif : identifiant Google Analytics 4 (G-XXXXXXX). Vide = aucune mesure d'audience et pas de bandeau cookies
VITE_GA_ID=
# Facultatif : clé publique (sitekey) du captcha Cloudflare Turnstile. Vide = pas de captcha.
# Clé de test (développement) : 1x00000000000000000000AA
VITE_TURNSTILE_SITEKEY=
